# Copy this file to .env for local development, then replace the placeholder.
# Keep .env out of Git; production values belong in Vercel Environment Variables.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-this-with-a-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave DATABASE_URL empty to use the local SQLite database.
# In production, set DATABASE_URL to the pooled Postgres connection URL.
# DATABASE_URL=

# Local development uses media/ on disk. Production needs two Vercel Blob
# stores because user uploads are private while catalogue images are public.
# Set both values in Vercel's project environment settings.
# BLOB_PUBLIC_READ_WRITE_TOKEN=
# BLOB_PRIVATE_READ_WRITE_TOKEN=

# Optional SpeciesNet model identifier. The default is the official Google
# camera-trap model; SpeciesNet downloads its model files on first inference.
# SPECIESNET_MODEL=kaggle:google/speciesnet/pyTorch/v4.0.3a/1

# Online identification: set these in Vercel Production, not in public files.
# Leave HF_SPACE_ID empty/unset to keep using the local model.
# HF_SPACE_ID=Ashwanikumar21/wildforindia-ai-test
# HF_TOKEN=your-hugging-face-read-token
# HF_INFERENCE_TIMEOUT=90
